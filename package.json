{
  "name": "workoutquest-api",
  "version": "2.0.0",
  "private": true,
  "description": "WorkoutQuest: a GraphQL workout tracker API with GitHub OAuth, MongoDB, and a web UI, written in TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "graphql": "^16.10.0",
    "mongodb": "^6.12.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
